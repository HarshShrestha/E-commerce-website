PORT=4000
NODE_ENV=development
# In-memory evaluation only. NEVER enable on a live store.
DEMO_MODE=true
JWT_SECRET=replace-this-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Full MongoDB connection string including database name. Required when DEMO_MODE=false.
MONGODB_URI=mongodb://127.0.0.1:27017/forever
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Required for admin image uploads and optional initial bulk upload (npm run images:upload).
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
